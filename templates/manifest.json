{
  "schemaVersion": 1,
  "swift": {
    "rules": [
      "0 - Tech Stack (App).md",
      "0 - Tech Stack (Package).md",
      "1- Architecture and Patterns.md",
      "2 - Project Structure (iOS-Visionos-macOS).md",
      "3 - Swift Library Package Structure.md",
      "4 - Using ViewModels.md",
      "5 - Atomic Design.md",
      "6 - Coding Styles.md",
      "7 - Testing.md",
      "8 - App Composition.md"
    ],
    "defaults": {
      "iOSApp": [
        "0 - Tech Stack (App).md",
        "1- Architecture and Patterns.md",
        "2 - Project Structure (iOS-Visionos-macOS).md",
        "4 - Using ViewModels.md",
        "5 - Atomic Design.md",
        "6 - Coding Styles.md",
        "7 - Testing.md",
        "8 - App Composition.md"
      ],
      "macOSApp": [
        "0 - Tech Stack (App).md",
        "1- Architecture and Patterns.md",
        "2 - Project Structure (iOS-Visionos-macOS).md",
        "4 - Using ViewModels.md",
        "5 - Atomic Design.md",
        "6 - Coding Styles.md",
        "7 - Testing.md",
        "8 - App Composition.md"
      ],
      "swiftPackage": [
        "0 - Tech Stack (Package).md",
        "1- Architecture and Patterns.md",
        "3 - Swift Library Package Structure.md",
        "6 - Coding Styles.md",
        "7 - Testing.md"
      ]
    },
    "guides": [
      "CLAUDE.md SWIFT.md",
      "CLAUDE.md Structure for iOS Projects.md"
    ],
    "swiftlint": "swiftlint.yml",
    "hooks": [
      {
        "id": "lintOnEdit",
        "title": "Lint on edit",
        "summary": "Runs swiftlint on every Swift file Claude edits and reports violations to Claude.",
        "event": "PostToolUse",
        "matcher": "Edit|MultiEdit|Write",
        "script": "hooks/swiftlint-on-edit.sh"
      },
      {
        "id": "blockDangerousCommands",
        "title": "Block dangerous commands",
        "summary": "Refuses `rm -rf /`, `git push --force` and `git reset --hard` before they run.",
        "event": "PreToolUse",
        "matcher": "Bash",
        "script": "hooks/block-dangerous-commands.sh"
      }
    ],
    "hookDefaults": {
      "iOSApp": [
        "lintOnEdit",
        "blockDangerousCommands"
      ],
      "macOSApp": [
        "lintOnEdit",
        "blockDangerousCommands"
      ],
      "swiftPackage": [
        "lintOnEdit",
        "blockDangerousCommands"
      ]
    }
  },
  "python": {
    "rules": [
      "Coding Rules.md"
    ],
    "defaults": {
      "pythonCLI": [
        "Coding Rules.md"
      ]
    },
    "guides": [],
    "hooks": [
      {
        "id": "formatOnEdit",
        "title": "Format on edit",
        "summary": "Runs `ruff format` on every Python file Claude edits.",
        "event": "PostToolUse",
        "matcher": "Edit|MultiEdit|Write",
        "script": "hooks/ruff-format-on-edit.sh"
      },
      {
        "id": "lintOnEdit",
        "title": "Lint on edit",
        "summary": "Runs `ruff check` on every Python file Claude edits and reports violations to Claude.",
        "event": "PostToolUse",
        "matcher": "Edit|MultiEdit|Write",
        "script": "hooks/ruff-check-on-edit.sh"
      },
      {
        "id": "blockDangerousCommands",
        "title": "Block dangerous commands",
        "summary": "Refuses `rm -rf /`, `git push --force` and `git reset --hard` before they run.",
        "event": "PreToolUse",
        "matcher": "Bash",
        "script": "hooks/block-dangerous-commands.sh"
      }
    ],
    "hookDefaults": {
      "pythonCLI": [
        "formatOnEdit",
        "lintOnEdit",
        "blockDangerousCommands"
      ]
    }
  }
}
